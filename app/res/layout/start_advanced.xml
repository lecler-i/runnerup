<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:runnerup="http://schemas.android.com/apk/res-auto"
    android:id="@+id/start_advanced_tab"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <org.runnerup.widget.TitleSpinner
        android:id="@+id/advanced_audio_cue_spinner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentStart="true"
        android:layout_alignParentTop="true"
        android:key="@string/pref_advanced_audio"
        android:layout_marginEnd="@dimen/activity_margin"
        android:layout_marginTop="@dimen/activity_margin"
        android:text="@string/Audio_cue_settings"
        runnerup:type="spinner_txt" />

    <org.runnerup.widget.TitleSpinner
        android:id="@+id/advanced_workout_spinner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentStart="true"
        android:layout_below="@id/advanced_audio_cue_spinner"
        android:key="@string/pref_advanced_workout"
        android:layout_marginBottom="16dp"
        android:layout_marginStart="@dimen/activity_margin"
        android:layout_marginEnd="@dimen/activity_margin"
        android:text="@string/Workout"
        runnerup:type="spinner_txt" />

    <TextView
        android:id="@+id/advanced_generated_banner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/advanced_workout_spinner"
        android:layout_marginStart="@dimen/activity_margin"
        android:layout_marginEnd="@dimen/activity_margin"
        android:layout_marginBottom="8dp"
        android:text="@string/Generated_workout_not_saved"
        android:visibility="gone" />

    <org.runnerup.widget.TitleSpinner
        android:id="@+id/generated_style_spinner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/advanced_generated_banner"
        android:layout_marginStart="@dimen/activity_margin"
        android:layout_marginEnd="@dimen/activity_margin"
        android:defaultValue="0"
        android:key="@string/pref_generated_style"
        android:text="@string/Generated_interval_style"
        android:entries="@array/generated_style_entries"
        android:visibility="gone"
        runnerup:values="@array/generated_style_values" />

    <org.runnerup.widget.TitleSpinner
        android:id="@+id/generated_level_spinner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/generated_style_spinner"
        android:layout_marginStart="@dimen/activity_margin"
        android:layout_marginEnd="@dimen/activity_margin"
        android:defaultValue="1"
        android:key="@string/pref_generated_level"
        android:text="@string/Generated_level"
        android:entries="@array/generated_level_entries"
        android:visibility="gone"
        runnerup:values="@array/generated_level_values" />

    <Button
        android:id="@+id/generated_workout_button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/generated_level_spinner"
        android:layout_marginStart="@dimen/activity_margin"
        android:layout_marginEnd="@dimen/activity_margin"
        android:layout_marginTop="8dp"
        android:minHeight="48dp"
        android:text="@string/Generate_from_recent_runs"
        android:visibility="gone" />

    <ListView
        android:id="@+id/advanced_step_list"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_below="@id/generated_workout_button"
        android:background="@color/subsectionBg"
        android:cacheColorHint="@color/subsectionBg"
        android:clipToPadding="false"
        android:minWidth="48dp"
        android:minHeight="48dp"
        android:paddingLeft="@dimen/activity_margin"
        android:paddingRight="@dimen/activity_margin"
        android:paddingTop="@dimen/activity_margin"
        android:paddingBottom="@dimen/margin_for_fab"
        android:scrollbarAlwaysDrawVerticalTrack="true" />

</RelativeLayout>
